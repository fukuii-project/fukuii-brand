{
  "$description": "Fukuii component recipes. Each entry says which token a part reads, per variant and per state. Because these reference ROLE tokens, and role tokens are per-theme, a component themes correctly in light and dark without being defined twice.\n\nDELIBERATELY NO DENSITY. Padding, gaps, sizes and line-heights are each product's own decision — a desktop app is tighter than a marketing page. What is here is what must be CONSISTENT: color relationships, typographic voice, and shape intent.",
  "focus": {
    "$description": "Universal and non-negotiable. Every interactive element on every surface gets a visible focus indicator. Applied on keyboard focus only (:focus-visible on web).",
    "color": {
      "$type": "color",
      "$value": "{color.green-3}"
    },
    "width": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "offset": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    }
  },
  "selection": {
